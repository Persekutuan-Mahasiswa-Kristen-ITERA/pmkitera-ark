# Database (PostgreSQL via Supabase)
# DATABASE_URL: Transaction pooler (port 6543) — untuk runtime queries
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct connection (port 5432) — untuk migrate/db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Auth (untuk admin login di masa depan)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Session Secret (minimal 32 karakter, gunakan string acak yang kuat)
SESSION_SECRET="your-random-64-char-secret-minimum"

# Cloudflare R2 / S3-compatible Object Storage
R2_ACCOUNT_ID="[HASH]"
R2_ACCESS_KEY_ID="hash"
R2_SECRET_ACCESS_KEY="hash"
R2_BUCKET_NAME="pmk-ark-storage"
R2_PUBLIC_URL="https://pub-[HASH].r2.dev"
# S3 Compatibility settings for alternative providers
STORAGE_ENDPOINT="https://[HASH].r2.cloudflarestorage.com"
STORAGE_REGION="auto"

# Optional: Production site URL (untuk self-referencing jika diperlukan)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
